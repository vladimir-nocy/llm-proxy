# Loaded automatically from the working directory or a parent directory.
# Exported environment variables take precedence.

# ── Claude adapter: your subscription as an Anthropic-compatible API ────
# Token sources, in order: env token → session file → Claude Code
# credentials (~/.claude/.credentials.json or the macOS Keychain).
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Overrides:
# CLAUDE_API_BASE=https://api.anthropic.com
# CLAUDE_TOKEN_URL=https://platform.claude.com/v1/oauth/token
# CLAUDE_SESSION_FILE=~/.llm-proxy/claude-session.json
# CLAUDE_CREDENTIALS_FILE=~/.claude/.credentials.json
# CLAUDE_USE_KEYCHAIN=1

# ── Codex adapter: your ChatGPT plan as a Responses API ─────────────────
# Run `codex login` once; the gateway reads ~/.codex/auth.json and refreshes
# tokens itself (written back so the CLI stays logged in).
# CODEX_OAUTH_TOKEN=eyJ...
# CODEX_API_BASE=https://chatgpt.com/backend-api/codex
# CODEX_TOKEN_URL=https://auth.openai.com/oauth/token
# CODEX_SESSION_FILE=~/.llm-proxy/codex-session.json
# CODEX_AUTH_FILE=~/.codex/auth.json

# HTTP API auth (required for callers beyond loopback)
# GATEWAY_TOKEN=some-long-random-string
GATEWAY_PORT=7781
# GATEWAY_BIND=127.0.0.1

# ── REST adapter: any API, no Claude needed ─────────────────────────────
# Point it at any JSON API. Auth is optional.
REST_BASE_URL=https://api.github.com
# REST_BASE_PATH=/api/v1            # prefix for every call, if the API has one

# Auth (normally pick one; both can be sent if the API requires them):
# REST_TOKEN=ghp_xxx                # → Authorization: Bearer <token>
# REST_API_KEY=key                  # → sent in REST_API_KEY_HEADER (default x-api-key)
# REST_API_KEY_HEADER=x-api-key

# Extra static headers as a JSON object:
# REST_HEADERS='{"x-team":"billy-boys"}'
