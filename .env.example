# Forge studio server
FORGE_URL=http://sumos-macbook-pro.local:7700

# Auth — option A: username + password (gateway logs in and keeps the session)
FORGE_USER=your-username
FORGE_PASSWORD=your-password

# Auth — option B: paste a session cookie from your browser instead
# (DevTools > Application > Cookies > http://sumos-macbook-pro.local:7700 — copy the whole value)
# FORGE_COOKIE=forge_session=...

# HTTP API hardening (required if you bind beyond loopback)
# GATEWAY_TOKEN=some-long-random-string

# HTTP API options
GATEWAY_PORT=7781
# GATEWAY_BIND=127.0.0.1

# Where the gateway caches the Forge session cookie between restarts
# (default: ~/.agent-gateway/forge-session.json)
# FORGE_SESSION_FILE=./forge-session.json
